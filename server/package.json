{
  "name": "mws-website-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:seed:cms-roles": "bun run src/scripts/seed-cms-roles.ts",
    "db:seed:madlabs-super-admins": "bun run src/scripts/seed-madlabs-super-admins.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.10.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.1.0",
    "googleapis": "^185.0.0",
    "hono": "^4.13.5",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^4.5.4"
  }
}
