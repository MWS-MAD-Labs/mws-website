PORT=4004
FRONTEND_ORIGIN=http://localhost:7001

DATABASE_URL=postgresql://mws_website:postgres@localhost:55432/mws_website?schema=public
SHADOW_DATABASE_URL=postgresql://mws_website:postgres@localhost:55432/mws_website_shadow?schema=public

# Session signing secret. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Central identity lookup used by CMS SSO.
CENTRAL_API_BASE_URL=https://central.example.test/api/internal
CENTRAL_API_TOKEN=replace-with-central-api-token

# Google OAuth for CMS login.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:7001/auth/google/callback

# Outgoing email (CMS invitations, new-inquiry notifications).
# MAIL_TRANSPORT: "smtp" or "gmail" forces one transport; empty = Gmail API
# when GOOGLE_SA_* is set, otherwise SMTP. Use "smtp" while the service
# account is not yet delegated https://www.googleapis.com/auth/gmail.send.
MAIL_TRANSPORT=
# Preferred: Google service account sending through the Gmail API. Copy
# client_email and private_key from the service account JSON (keep the key on
# one line with its literal \n). The service account needs domain-wide
# delegation for https://www.googleapis.com/auth/gmail.send, and MAIL_SENDER
# must be a real Workspace mailbox. Never commit the JSON file itself.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
MAIL_SENDER=noreply@millennia21.id
MAIL_SENDER_NAME=Millennia World School

# Who receives an email for every new Contact form inquiry (comma separated).
INQUIRY_NOTIFY_EMAILS=

# Fallback when the service account is not set: SMTP (same no-reply account as
# the other MWS apps). With neither configured, invitations and inquiries are
# still saved; only the email is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Explicit SUPER_ADMIN bootstrap allowlist. MAD Labs membership alone is not enough.
CMS_BOOTSTRAP_SUPER_ADMIN_EMAILS=admin@example.test
CMS_BOOTSTRAP_SUPER_ADMIN_CENTRAL_IDS=

# MinIO / S3-compatible storage for galleries and news media.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=mws-gallery
MINIO_REGION=us-east-1
