generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUM
// =========================

enum VideoSourceType {
  YOUTUBE
  UPLOAD
}


enum HeroSlideMediaType {
  IMAGE
  VIDEO
}

enum HeroSlideSourceType {
  MANUAL
  PROGRAM
  ADMISSION
  CAMPUS_TOUR
  CURRICULUM
  AFFILIATION
  ACADEMIC
  KINDERGARTEN
  ELEMENTARY
  JUNIOR_HIGH
  OUR_SCHOOL
  CONTACT
}

// =========================
// CMS USER
// =========================

model CmsRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users CmsUser[]
}

model CmsUser {
  id            String   @id @default(uuid()) @db.Uuid
  centralUserId String   @unique
  name          String   @db.VarChar(255)
  unitId        String
  cmsRoleId     String   @db.Uuid
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role      CmsRole    @relation(fields: [cmsRoleId], references: [id])
  auditLogs AuditLog[]
  cmsPages  CmsPage[]
}

// =========================
// GALLERY
// =========================

model Gallery {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images GalleryImage[]
  videos GalleryVideo[]

  programs     Program[]
  admissions   Admission[]
  campusTours  CampusTour[]
  curriculums  Curriculum[]
  affiliations Affiliation[]

  academics     Academic[]
  ourSchools    OurSchool[]
  contacts      Contact[]
  kindergartens Kindergarten[]
  elementaries  Elementary[]
  juniorHighs   JuniorHigh[]
  communityStoriesPages CommunityStoriesPage[]
  newsPosts     NewsPost[]
}

model GalleryImage {
  id        String   @id @default(uuid()) @db.Uuid
  galleryId String   @db.Uuid
  path      String   @db.VarChar(500)
  title     String?  @db.VarChar(255)
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gallery Gallery @relation(fields: [galleryId], references: [id])

  featuredInOurSchools OurSchool[] @relation("OurSchoolFeaturedImage")
}

model GalleryVideo {
  id         String          @id @default(uuid()) @db.Uuid
  galleryId  String          @db.Uuid
  sourceType VideoSourceType
  source     String          @db.VarChar(1000)
  title      String?         @db.VarChar(255)
  caption    String?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  gallery Gallery @relation(fields: [galleryId], references: [id])
}

// =========================
// PROGRAM
// =========================

model Program {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  ageRange    String?  @db.VarChar(100)
  description String?
  imagePath   String?  @db.VarChar(1000)
  imageAlt    String?  @db.VarChar(255)
  path        String?  @db.VarChar(500)
  galleryId   String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery Gallery? @relation(fields: [galleryId], references: [id])

  admissions   Admission[]
  campusTours  CampusTour[]
  curriculums  Curriculum[]
  affiliations Affiliation[]
}

model Admission {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  adminWhatsapp String? @db.VarChar(100)
  contactLabel String? @db.VarChar(100)
  exploreLabel String? @db.VarChar(100)
  galleryId   String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program  @relation(fields: [programId], references: [id])
  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

model CampusTour {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program  @relation(fields: [programId], references: [id])
  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

model Curriculum {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program  @relation(fields: [programId], references: [id])
  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

model Affiliation {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program  @relation(fields: [programId], references: [id])
  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

// =========================
// ACADEMIC
// =========================

model Academic {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery Gallery? @relation(fields: [galleryId], references: [id])

  kindergartens Kindergarten[]
  elementaries  Elementary[]
  juniorHighs   JuniorHigh[]
}

model Kindergarten {
  id          String   @id @default(uuid()) @db.Uuid
  academicId  String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academic Academic @relation(fields: [academicId], references: [id])
  gallery  Gallery? @relation(fields: [galleryId], references: [id])
}

model Elementary {
  id          String   @id @default(uuid()) @db.Uuid
  academicId  String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academic Academic @relation(fields: [academicId], references: [id])
  gallery  Gallery? @relation(fields: [galleryId], references: [id])
}

model JuniorHigh {
  id          String   @id @default(uuid()) @db.Uuid
  academicId  String   @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academic Academic @relation(fields: [academicId], references: [id])
  gallery  Gallery? @relation(fields: [galleryId], references: [id])
}

// =========================
// OTHER CONTENT
// =========================

model OurSchool {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(255)
  description     String?
  content         Json?
  galleryId       String?  @db.Uuid
  featuredImageId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gallery       Gallery?      @relation(fields: [galleryId], references: [id])
  featuredImage GalleryImage? @relation("OurSchoolFeaturedImage", fields: [featuredImageId], references: [id])
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  galleryId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

model CmsPage {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(255)
  title       String   @db.VarChar(500)
  body        Json
  template    String?  @db.VarChar(100)
  status      String?  @db.VarChar(50)
  publishedAt DateTime?
  createdBy   String?  @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CmsUser? @relation(fields: [createdBy], references: [id])
}

model CommunityStoriesPage {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  heroImagePath String? @db.VarChar(1000)
  heroImageAlt  String? @db.VarChar(255)
  introTitle    String? @db.VarChar(500)
  introBody     Json?
  galleryId     String? @db.Uuid
  isPublished   Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

model CommunityVoice {
  id        String   @id @default(uuid()) @db.Uuid
  role      String   @db.VarChar(100)
  name      String   @db.VarChar(255)
  grade     String?  @db.VarChar(255)
  quote     String
  imagePath String   @db.VarChar(1000)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsPost {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(500)
  slug        String   @unique @db.VarChar(500)
  excerpt     String?
  imagePath   String?  @db.VarChar(1000)
  imageAlt    String?  @db.VarChar(255)
  galleryId   String?  @db.Uuid
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery Gallery? @relation(fields: [galleryId], references: [id])
}

// =========================
// AUDIT LOG
// =========================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  cmsUserId  String?  @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Uuid
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime @default(now())

  cmsUser CmsUser? @relation(fields: [cmsUserId], references: [id])
}

// heroSlides


model HeroSlide {
  id          String   @id @default(uuid()) @db.Uuid

  sourceType  HeroSlideSourceType @default(MANUAL)
  sourceId    String?             @db.Uuid

  title       String?  @db.VarChar(255)
  description String?
  caption     String?

  mediaType   HeroSlideMediaType?
  mediaPath   String?  @db.VarChar(1000)
  mediaAlt    String?  @db.VarChar(255)
  posterPath  String?  @db.VarChar(1000)

  isLooping   Boolean  @default(true)

  ctaLabel    String?  @db.VarChar(100)
  ctaUrl      String?  @db.VarChar(1000)

  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
