generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ROLES
// ============================================================

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(50)
  label       String?   @db.VarChar(100)
  permissions Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  users User[]

  @@map("roles")
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  roleId       String?   @map("role_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  role                 Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  ownedMedia           MediaAsset[]  @relation("MediaOwner")
  authoredNews         NewsPost[]    @relation("NewsAuthor")
  assignedInquiries    Inquiry[]     @relation("InquiryAssignee")
  applications         Application[] @relation("ApplicantParent")
  assignedApplications Application[] @relation("ApplicationOfficer")
  createdEvents        Event[]       @relation("EventCreator")
  createdPages         CmsPage[]     @relation("PageCreator")
  chatSessions         ChatSession[]
  activityLogs         ActivityLog[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

// ============================================================
// MEDIA ASSETS
// ============================================================

model MediaAsset {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String?   @map("owner_id") @db.Uuid
  url       String    @db.Text
  filename  String?   @db.VarChar(255)
  mimeType  String?   @map("mime_type") @db.VarChar(100)
  width     Int?
  height    Int?
  sizeBytes BigInt?   @map("size_bytes")
  altText   String?   @map("alt_text") @db.VarChar(512)
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner              User?                 @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campusHero         Campus[]              @relation("CampusHeroImage")
  programThumbnails  AcademicProgram[]     @relation("ProgramThumbnail")
  newsHero           NewsPost[]            @relation("NewsHeroMedia")
  testimonialVideos  Testimonial[]         @relation("TestimonialVideo")
  testimonialPosters Testimonial[]         @relation("TestimonialPoster")
  applicationDocs    ApplicationDocument[]

  @@index([ownerId], map: "idx_media_owner")
  @@map("media_assets")
}

// ============================================================
// CAMPUSES
// ============================================================

model Campus {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(200)
  slug        String    @unique @db.VarChar(200)
  address     String?   @db.Text
  phone       String?   @db.VarChar(50)
  email       String?   @db.VarChar(255)
  mapEmbed    String?   @map("map_embed") @db.Text
  heroImageId String?   @map("hero_image_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  heroImage        MediaAsset?       @relation("CampusHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  academicPrograms AcademicProgram[]
  inquiries        Inquiry[]
  tuitionFees      TuitionFee[]
  events           Event[]

  @@map("campuses")
}

// ============================================================
// ACADEMIC PROGRAMS
// ============================================================

model AcademicProgram {
  id          String    @id @default(uuid()) @db.Uuid
  campusId    String?   @map("campus_id") @db.Uuid
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(150)
  level       String?   @db.VarChar(50)
  ageRange    String?   @map("age_range") @db.VarChar(50)
  summary     String?   @db.Text
  content     Json?
  thumbnailId String?   @map("thumbnail_id") @db.Uuid
  published   Boolean   @default(true)
  orderIndex  Int?      @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  campus       Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  thumbnail    MediaAsset?   @relation("ProgramThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  applications Application[]
  tuitionFees  TuitionFee[]
  events       Event[]

  @@index([campusId], map: "idx_programs_campus")
  @@map("academic_programs")
}

// ============================================================
// NEWS CATEGORIES
// ============================================================

model NewsCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  posts NewsPost[]

  @@map("news_categories")
}

// ============================================================
// NEWS POSTS
// ============================================================

model NewsPost {
  id           String                   @id @default(uuid()) @db.Uuid
  authorId     String?                  @map("author_id") @db.Uuid
  categoryId   String?                  @map("category_id") @db.Uuid
  title        String                   @db.VarChar(500)
  slug         String                   @unique @db.VarChar(500)
  excerpt      String?                  @db.Text
  content      Json
  heroMediaId  String?                  @map("hero_media_id") @db.Uuid
  status       String                   @default("published") @db.VarChar(50)
  publishedAt  DateTime?                @map("published_at") @db.Timestamptz(6)
  featured     Boolean                  @default(false)
  meta         Json?
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?                @map("deleted_at") @db.Timestamptz(6)

  author    User?         @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category  NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  heroMedia MediaAsset?   @relation("NewsHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  postTags  NewsPostTag[]

  @@index([publishedAt], map: "idx_news_published_at")
  @@index([status], map: "idx_news_status")
  @@index([categoryId], map: "idx_news_category")
  @@map("news_posts")
}

// ============================================================
// NEWS TAGS
// ============================================================

model NewsTag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  postTags NewsPostTag[]

  @@map("news_tags")
}

// ============================================================
// NEWS POST TAGS
// ============================================================

model NewsPostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  NewsTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("news_post_tags")
}

// ============================================================
// TESTIMONIALS
// ============================================================

model Testimonial {
  id            String    @id @default(uuid()) @db.Uuid
  authorName    String    @map("author_name") @db.VarChar(255)
  role          String?   @db.VarChar(100)
  grade         String?   @db.VarChar(100)
  quote         String?   @db.Text
  videoMediaId  String?   @map("video_media_id") @db.Uuid
  posterMediaId String?   @map("poster_media_id") @db.Uuid
  visible       Boolean   @default(true)
  sortOrder     Int?      @map("sort_order")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  videoMedia  MediaAsset? @relation("TestimonialVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)
  posterMedia MediaAsset? @relation("TestimonialPoster", fields: [posterMediaId], references: [id], onDelete: SetNull)

  @@index([visible], map: "idx_testimonials_visible")
  @@map("testimonials")
}

// ============================================================
// FAQ ITEMS
// ============================================================

model FaqItem {
  id         String    @id @default(uuid()) @db.Uuid
  question   String    @db.VarChar(500)
  answer     String    @db.Text
  category   String?   @db.VarChar(100)
  orderIndex Int?      @map("order_index")
  visible    Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("faq_items")
}

// ============================================================
// INQUIRIES
// ============================================================

model Inquiry {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @default("tour") @db.VarChar(50)
  parentName    String    @map("parent_name") @db.VarChar(255)
  email         String    @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  childLevel    String?   @map("child_level") @db.VarChar(100)
  preferredDate DateTime? @map("preferred_date") @db.Date
  message       String?   @db.Text
  campusId      String?   @map("campus_id") @db.Uuid
  status        String    @default("new") @db.VarChar(50)
  assignedTo    String?   @map("assigned_to") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  handledAt     DateTime? @map("handled_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
  assignee User?   @relation("InquiryAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status], map: "idx_inquiries_status")
  @@index([email], map: "idx_inquiries_email")
  @@map("inquiries")
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id                String    @id @default(uuid()) @db.Uuid
  applicantParentId String?   @map("applicant_parent_id") @db.Uuid
  childName         String    @map("child_name") @db.VarChar(255)
  childDob          DateTime? @map("child_dob") @db.Date
  programId         String?   @map("program_id") @db.Uuid
  applicationStatus String    @default("submitted") @map("application_status") @db.VarChar(50)
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  assignedOfficerId String?   @map("assigned_officer_id") @db.Uuid
  notes             String?   @db.Text
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  applicantParent User?                 @relation("ApplicantParent", fields: [applicantParentId], references: [id], onDelete: SetNull)
  program         AcademicProgram?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  assignedOfficer User?                 @relation("ApplicationOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  documents       ApplicationDocument[]

  @@index([applicationStatus], map: "idx_applications_status")
  @@map("applications")
}

// ============================================================
// APPLICATION DOCUMENTS
// ============================================================

model ApplicationDocument {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  mediaId       String   @map("media_id") @db.Uuid
  docType       String   @map("doc_type") @db.VarChar(100)
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  visible       Boolean  @default(true)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  media       MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("application_documents")
}

// ============================================================
// TUITION FEES
// ============================================================

model TuitionFee {
  id            String    @id @default(uuid()) @db.Uuid
  campusId      String?   @map("campus_id") @db.Uuid
  programId     String?   @map("program_id") @db.Uuid
  academicYear  String    @map("academic_year") @db.VarChar(20)
  feeCurrency   String    @default("IDR") @map("fee_currency") @db.VarChar(10)
  feeItems      Json      @map("fee_items")
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(12, 2)
  published     Boolean   @default(true)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  campus  Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  program AcademicProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([programId, academicYear], map: "idx_tuition_program_year")
  @@map("tuition_fees")
}

// ============================================================
// EVENTS
// ============================================================

model Event {
  id               String    @id @default(uuid()) @db.Uuid
  campusId         String?   @map("campus_id") @db.Uuid
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  startAt          DateTime  @map("start_at") @db.Timestamptz(6)
  endAt            DateTime? @map("end_at") @db.Timestamptz(6)
  allDay           Boolean   @default(false) @map("all_day")
  location         String?   @db.VarChar(255)
  relatedProgramId String?   @map("related_program_id") @db.Uuid
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  campus         Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  relatedProgram AcademicProgram? @relation(fields: [relatedProgramId], references: [id], onDelete: SetNull)
  creator        User?            @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([startAt], map: "idx_events_start_at")
  @@map("events")
}

// ============================================================
// CMS PAGES
// ============================================================

model CmsPage {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(255)
  title       String    @db.VarChar(500)
  body        Json
  template    String?   @db.VarChar(100)
  meta        Json?
  status      String?   @default("published") @db.VarChar(50)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  creator User? @relation("PageCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("cms_pages")
}

// ============================================================
// CHAT SESSIONS
// ============================================================

model ChatSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  sessionToken String?   @map("session_token") @db.VarChar(255)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  metadata     Json?

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId], map: "idx_chat_session_user")
  @@map("chat_sessions")
}

// ============================================================
// CHAT MESSAGES
// ============================================================

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  sender      String   @db.VarChar(50)
  message     String   @db.Text
  messageMeta Json?    @map("message_meta")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ============================================================
// ACTIVITY LOGS
// ============================================================

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  actionType  String   @map("action_type") @db.VarChar(100)
  targetTable String?  @map("target_table") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.Uuid
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(255)
  value     Json?
  scope     String?  @default("global") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}
